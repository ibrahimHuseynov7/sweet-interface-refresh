# --- Azure OpenAI (one key for both deployments) ---------------------------------
AZURE_OPENAI_ENDPOINT=https://ds-ai-shopping-assistant-rs.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Router (orchestrator)
AZURE_DEPLOYMENT_ORCHESTRATOR=birchat-decision-1-test
# Module agent, responder, voice summary
AZURE_OPENAI_DEPLOYMENT=si-gpt-6-luna-eval
# Web search (gpt-6-luna built-in web search). SEARCH_PROVIDER=tavily|brave switches back.
SEARCH_PROVIDER=azure
AZURE_DEPLOYMENT_WEB_SEARCH=si-gpt-6-luna-eval

# --- Voice: OmniVoice sidecar (see omnivoice-server/README.md) -------------------
OMNIVOICE_URL=http://localhost:8008
OMNIVOICE_API_KEY=
# Optional voice design override, e.g. "male, middle-aged, low pitch"
OMNIVOICE_INSTRUCT=
